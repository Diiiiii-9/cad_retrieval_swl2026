# ==========================================
# CAD Retrieval Project - .gitignore
# ==========================================

# 1. Raw Data & Labels (Prevent heavy file uploads)
*.step
*.stp
*.face_truth
*.seg

# 2. Processed Graph Data (PyG and Pickle files)
*.pt
*.graph

# Ignore the contents of data directories but keep the folder structure
data/raw_step/mfcad/*
!data/raw_step/mfcad/.gitkeep
data/raw_step/mfcad_label/*
!data/raw_step/mfcad_label/.gitkeep
data/raw_step/fusion360/*
!data/raw_step/fusion360/.gitkeep
data/raw_step/fusion360_label/*
!data/raw_step/fusion360_label/.gitkeep
data/processed_graphs/mfcad/*
!data/processed_graphs/mfcad/.gitkeep
data/processed_graphs/fusion360/*
!data/processed_graphs/fusion360/.gitkeep

# 3. Model Weights & Vector Databases
# checkpoints/*
# !checkpoints/.gitkeep
# *.pth       # PyTorch model weights
# *.bin       # FAISS index files

# 4. Python Virtual Environments
venv/
env/
.venv/
.conda/
miniconda3/

# 5. Python Cache & Build Files
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/

# 6. Logging & Outputs
*.log
runs/       # TensorBoard logs (if used later)
wandb/      # Weights & Biases logs (if used later)

# 7. Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# 8. OS & IDE Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
# 9. Large outputs of the LRZ experiment runs (keep configs, loss curves and results; not weights/indices)
logs/
checkpoints/final_mfcad/**/*.pth
checkpoints/final_mfcad/**/*.bin
checkpoints/final_mfcad/**/*.pkl
checkpoints/sweep_fusion360/**/*.pth
checkpoints/sweep_fusion360/**/*.bin
checkpoints/sweep_fusion360/**/*.pkl
checkpoints/fusion360_from_mfcad/
.pytest_cache/
